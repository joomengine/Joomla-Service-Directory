<?xml version="1.0" encoding="utf-8"?>
<form
	addruleprefix="JoomService\Component\Servicedirectory\Administrator\Rule"
	addfieldprefix="JoomService\Component\Servicedirectory\Administrator\Field"
>
	<config>
		<inlinehelp button="show"/>
	</config>
	<fieldset name="details">
		<!-- Default Fields. -->
		<!-- Id Field. Type: Text (joomla) -->
		<field
			name="id"
			type="text" class="readonly" label="JGLOBAL_FIELD_ID_LABEL"
			description ="JGLOBAL_FIELD_ID_DESC" size="10" default="0"
			readonly="true"
		/>
		<!-- Date Created Field. Type: Calendar (joomla) -->
		<field
			name="created"
			type="calendar"
			label="COM_SERVICEDIRECTORY_SUBREGION_CREATED_DATE_LABEL"
			description="COM_SERVICEDIRECTORY_SUBREGION_CREATED_DATE_DESC"
			size="22"
			format="%Y-%m-%d %H:%M:%S"
			filter="user_utc"
		/>
		<!-- User Created Field. Type: User (joomla) -->
		<field
			name="created_by"
			type="user"
			label="COM_SERVICEDIRECTORY_SUBREGION_CREATED_BY_LABEL"
			description="COM_SERVICEDIRECTORY_SUBREGION_CREATED_BY_DESC"
		/>
		<!-- Published Field. Type: List (joomla) -->
		<field name="published" type="list" label="JSTATUS"
			description="JFIELD_PUBLISHED_DESC" class="chzn-color-state"
			filter="intval" size="1" default="1" >
			<option value="1">
				JPUBLISHED</option>
			<option value="0">
				JUNPUBLISHED</option>
			<option value="2">
				JARCHIVED</option>
			<option value="-2">
				JTRASHED</option>
		</field>
		<!-- Date Modified Field. Type: Calendar (joomla) -->
		<field name="modified" type="calendar" class="readonly"
			label="COM_SERVICEDIRECTORY_SUBREGION_MODIFIED_DATE_LABEL" description="COM_SERVICEDIRECTORY_SUBREGION_MODIFIED_DATE_DESC"
			size="22" readonly="true" format="%Y-%m-%d %H:%M:%S" filter="user_utc" />
		<!-- User Modified Field. Type: User (joomla) -->
		<field name="modified_by" type="user"
			label="COM_SERVICEDIRECTORY_SUBREGION_MODIFIED_BY_LABEL"
			description="COM_SERVICEDIRECTORY_SUBREGION_MODIFIED_BY_DESC"
			class="readonly"
			readonly="true"
			filter="unset"
		/>
		<!-- Access Field. Type: Accesslevel (joomla) -->
		<field name="access"
			type="accesslevel"
			label="JFIELD_ACCESS_LABEL"
			description="JFIELD_ACCESS_DESC"
			default="1"
			required="false"
		/>
		<!-- Ordering Field. Type: Numbers (joomla) -->
		<field
			name="ordering"
			type="number"
			class="inputbox validate-ordering"
			label="COM_SERVICEDIRECTORY_SUBREGION_ORDERING_LABEL"
			description=""
			default="0"
			size="6"
			required="false"
		/>
		<!-- Version Field. Type: Text (joomla) -->
		<field
			name="version"
			type="text"
			class="readonly"
			label="COM_SERVICEDIRECTORY_SUBREGION_VERSION_LABEL"
			description="COM_SERVICEDIRECTORY_SUBREGION_VERSION_DESC"
			size="6"
			default="1"
			readonly="true"
			filter="unset"
		/>
		<!-- Was added due to Permissions JS needing a Title field -->
		<!-- Let us know at gh-629 should this change -->
		<!-- https://github.com/vdm-io/Joomla-Component-Builder/issues/629#issuecomment-750117235 -->
		<field
			name="title"
			type="hidden"
			default="servicedirectory subregion"
		/>
		<!-- Dynamic Fields. -->
		<!-- Name Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="name"
			label="COM_SERVICEDIRECTORY_SUBREGION_NAME_LABEL"
			size="40"
			maxlength="150"
			description="COM_SERVICEDIRECTORY_SUBREGION_NAME_DESCRIPTION"
			class="text_area"
			readonly="false"
			disabled="false"
			required="true"
			filter="STRING"
			message="COM_SERVICEDIRECTORY_SUBREGION_NAME_MESSAGE"
			hint="COM_SERVICEDIRECTORY_SUBREGION_NAME_HINT"
		/>
		<!-- Region Field. Type: Modalselect. (custom) -->
		<field
			type="ModalSelect"
			name="region"
			label="COM_SERVICEDIRECTORY_SUBREGION_REGION_LABEL"
			sql_title_table="#__servicedirectory_region"
			sql_title_column="name"
			data-key-name="guid"
			sql_title_key="guid"
			urlSelect="index.php?option=com_servicedirectory&amp;view=regions&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			urlNew="index.php?option=com_servicedirectory&amp;task=region.add&amp;layout=modal&amp;tmpl=component"
			urlEdit="index.php?option=com_servicedirectory&amp;task=region.edit&amp;guid={id}&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			titleSelect="COM_SERVICEDIRECTORY_SUBREGION_REGION_TITLESELECT"
			titleNew="COM_SERVICEDIRECTORY_SUBREGION_REGION_TITLENEW"
			titleEdit="COM_SERVICEDIRECTORY_SUBREGION_REGION_TITLEEDIT"
			iconSelect="icon-copy"
			select="true"
			new="true"
			edit="true"
			clear="true"
			required="true"
			class="input-large"
			description="COM_SERVICEDIRECTORY_SUBREGION_REGION_DESCRIPTION"
			hint="COM_SERVICEDIRECTORY_SUBREGION_REGION_HINT"
		/>
		<!-- Guid Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="guid"
			label="COM_SERVICEDIRECTORY_SUBREGION_GUID_LABEL"
			size="40"
			maxlength="40"
			description="COM_SERVICEDIRECTORY_SUBREGION_GUID_DESCRIPTION"
			class="text_area"
			readonly="true"
			filter="CMD"
			validate="guid"
			hint="COM_SERVICEDIRECTORY_SUBREGION_GUID_HINT"
		/>
		<!-- Countries Field. Type: Subform. (joomla) -->
		<field
			type="subform"
			name="countries"
			label="COM_SERVICEDIRECTORY_SUBREGION_COUNTRIES_LABEL"
			layout="joomla.form.field.subform.repeatable"
			multiple="true"
			buttons="add,remove"
			icon="list"
			min="0">
			<form hidden="true" name="list_countries_modal" repeat="true">
				<!-- Guid Field. Type: Hidden. (joomla) -->
				<field
					type="hidden"
					name="guid"
					default="0"
					filter="STRING"
				/>
				<!-- Name Field. Type: Text. (joomla) -->
				<field
					type="text"
					name="name"
					label="COM_SERVICEDIRECTORY_SUBREGION_NAME_LABEL"
					size="40"
					maxlength="150"
					description="COM_SERVICEDIRECTORY_SUBREGION_NAME_DESCRIPTION"
					class="text_area"
					readonly="false"
					disabled="false"
					required="true"
					filter="STRING"
					message="COM_SERVICEDIRECTORY_SUBREGION_NAME_MESSAGE"
					hint="COM_SERVICEDIRECTORY_SUBREGION_NAME_HINT"
				/>
				<!-- Iso3 Field. Type: Text. (joomla) -->
				<field
					type="text"
					name="iso3"
					label="COM_SERVICEDIRECTORY_SUBREGION_ISO3_LABEL"
					size="40"
					maxlength="3"
					description="COM_SERVICEDIRECTORY_SUBREGION_ISO3_DESCRIPTION"
					class="text_area"
					required="true"
					filter="WORD"
					message="COM_SERVICEDIRECTORY_SUBREGION_ISO3_MESSAGE"
					hint="COM_SERVICEDIRECTORY_SUBREGION_ISO3_HINT"
				/>
				<!-- Iso2 Field. Type: Text. (joomla) -->
				<field
					type="text"
					name="iso2"
					label="COM_SERVICEDIRECTORY_SUBREGION_ISO2_LABEL"
					size="40"
					maxlength="2"
					description="COM_SERVICEDIRECTORY_SUBREGION_ISO2_DESCRIPTION"
					class="text_area"
					required="true"
					filter="WORD"
					message="COM_SERVICEDIRECTORY_SUBREGION_ISO2_MESSAGE"
					hint="COM_SERVICEDIRECTORY_SUBREGION_ISO2_HINT"
				/>
				<!-- Capital Field. Type: Modalselect. (custom) -->
				<field
					type="ModalSelect"
					name="capital"
					label="COM_SERVICEDIRECTORY_SUBREGION_CAPITAL_LABEL"
					sql_title_table="#__servicedirectory_city"
					sql_title_column="name"
					data-key-name="guid"
					sql_title_key="guid"
					urlSelect="index.php?option=com_servicedirectory&amp;view=cities&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
					urlNew="index.php?option=com_servicedirectory&amp;task=city.add&amp;layout=modal&amp;tmpl=component"
					urlEdit="index.php?option=com_servicedirectory&amp;task=city.edit&amp;guid={id}&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
					titleSelect="COM_SERVICEDIRECTORY_SUBREGION_CAPITAL_TITLESELECT"
					titleNew="COM_SERVICEDIRECTORY_SUBREGION_CAPITAL_TITLENEW"
					titleEdit="COM_SERVICEDIRECTORY_SUBREGION_CAPITAL_TITLEEDIT"
					iconSelect="icon-copy"
					select="true"
					new="true"
					edit="true"
					clear="true"
					class="input-large"
					description="COM_SERVICEDIRECTORY_SUBREGION_CAPITAL_DESCRIPTION"
					hint="COM_SERVICEDIRECTORY_SUBREGION_CAPITAL_HINT"
				/>
				<!-- Native Field. Type: Text. (joomla) -->
				<field
					type="text"
					name="native"
					label="COM_SERVICEDIRECTORY_SUBREGION_NATIVE_LABEL"
					description="COM_SERVICEDIRECTORY_SUBREGION_NATIVE_DESCRIPTION"
					class="text_area"
					required="false"
					message="COM_SERVICEDIRECTORY_SUBREGION_NATIVE_MESSAGE"
					hint="COM_SERVICEDIRECTORY_SUBREGION_NATIVE_HINT"
				/>
				<!-- Nationality Field. Type: Text. (joomla) -->
				<field
					type="text"
					name="nationality"
					label="COM_SERVICEDIRECTORY_SUBREGION_NATIONALITY_LABEL"
					description="COM_SERVICEDIRECTORY_SUBREGION_NATIONALITY_DESCRIPTION"
					class="text_area"
					required="false"
					message="COM_SERVICEDIRECTORY_SUBREGION_NATIONALITY_MESSAGE"
				/>
				<!-- Currency_name Field. Type: Text. (joomla) -->
				<field
					type="text"
					name="currency_name"
					label="COM_SERVICEDIRECTORY_SUBREGION_CURRENCY_NAME_LABEL"
					size="40"
					maxlength="150"
					description="COM_SERVICEDIRECTORY_SUBREGION_CURRENCY_NAME_DESCRIPTION"
					class="text_area"
					filter="STRING"
					message="COM_SERVICEDIRECTORY_SUBREGION_CURRENCY_NAME_MESSAGE"
					hint="COM_SERVICEDIRECTORY_SUBREGION_CURRENCY_NAME_HINT"
				/>
				<!-- Codethree Field. Type: Text. (joomla) -->
				<field
					type="text"
					name="codethree"
					label="COM_SERVICEDIRECTORY_SUBREGION_CODETHREE_LABEL"
					size="40"
					maxlength="3"
					default=""
					description="COM_SERVICEDIRECTORY_SUBREGION_CODETHREE_DESCRIPTION"
					class="text_area"
					required="true"
					filter="WORD"
					message="COM_SERVICEDIRECTORY_SUBREGION_CODETHREE_MESSAGE"
					hint="COM_SERVICEDIRECTORY_SUBREGION_CODETHREE_HINT"
				/>
				<!-- Symbol Field. Type: Text. (joomla) -->
				<field
					type="text"
					name="symbol"
					label="COM_SERVICEDIRECTORY_SUBREGION_SYMBOL_LABEL"
					size="40"
					maxlength="7"
					default=""
					description="COM_SERVICEDIRECTORY_SUBREGION_SYMBOL_DESCRIPTION"
					class="text_area"
					required="true"
					filter="STRING"
					message="COM_SERVICEDIRECTORY_SUBREGION_SYMBOL_MESSAGE"
					hint="COM_SERVICEDIRECTORY_SUBREGION_SYMBOL_HINT"
				/>
				<!-- Numeric_code Field. Type: Text. (joomla) -->
				<field
					type="text"
					name="numeric_code"
					label="COM_SERVICEDIRECTORY_SUBREGION_NUMERIC_CODE_LABEL"
					description="COM_SERVICEDIRECTORY_SUBREGION_NUMERIC_CODE_DESCRIPTION"
					class="text_area"
					filter="INT"
					message="COM_SERVICEDIRECTORY_SUBREGION_NUMERIC_CODE_MESSAGE"
					hint="COM_SERVICEDIRECTORY_SUBREGION_NUMERIC_CODE_HINT"
				/>
				<!-- Phonecode Field. Type: Text. (joomla) -->
				<field
					type="text"
					name="phonecode"
					label="COM_SERVICEDIRECTORY_SUBREGION_PHONECODE_LABEL"
					description="COM_SERVICEDIRECTORY_SUBREGION_PHONECODE_DESCRIPTION"
					class="text_area"
					message="COM_SERVICEDIRECTORY_SUBREGION_PHONECODE_MESSAGE"
					hint="COM_SERVICEDIRECTORY_SUBREGION_PHONECODE_HINT"
				/>
				<!-- Tld Field. Type: Text. (joomla) -->
				<field
					type="text"
					name="tld"
					label="COM_SERVICEDIRECTORY_SUBREGION_TLD_LABEL"
					description="COM_SERVICEDIRECTORY_SUBREGION_TLD_DESCRIPTION"
					class="text_area"
					message="COM_SERVICEDIRECTORY_SUBREGION_TLD_MESSAGE"
					hint="COM_SERVICEDIRECTORY_SUBREGION_TLD_HINT"
				/>
				<!-- Emoji Field. Type: Text. (joomla) -->
				<field
					type="text"
					name="emoji"
					label="COM_SERVICEDIRECTORY_SUBREGION_EMOJI_LABEL"
					description="COM_SERVICEDIRECTORY_SUBREGION_EMOJI_DESCRIPTION"
					class="text_area"
					required="false"
					message="COM_SERVICEDIRECTORY_SUBREGION_EMOJI_MESSAGE"
				/>
				<!-- Emojiu Field. Type: Text. (joomla) -->
				<field
					type="text"
					name="emojiu"
					label="COM_SERVICEDIRECTORY_SUBREGION_EMOJIU_LABEL"
					description="COM_SERVICEDIRECTORY_SUBREGION_EMOJIU_DESCRIPTION"
					class="text_area"
					required="false"
					message="COM_SERVICEDIRECTORY_SUBREGION_EMOJIU_MESSAGE"
				/>
				<!-- Latitude Field. Type: Text. (joomla) -->
				<field
					type="text"
					name="latitude"
					label="COM_SERVICEDIRECTORY_SUBREGION_LATITUDE_LABEL"
					description="COM_SERVICEDIRECTORY_SUBREGION_LATITUDE_DESCRIPTION"
					class="text_area"
					message="COM_SERVICEDIRECTORY_SUBREGION_LATITUDE_MESSAGE"
					hint="COM_SERVICEDIRECTORY_SUBREGION_LATITUDE_HINT"
				/>
				<!-- Longitude Field. Type: Text. (joomla) -->
				<field
					type="text"
					name="longitude"
					label="COM_SERVICEDIRECTORY_SUBREGION_LONGITUDE_LABEL"
					description="COM_SERVICEDIRECTORY_SUBREGION_LONGITUDE_DESCRIPTION"
					class="text_area"
					message="COM_SERVICEDIRECTORY_SUBREGION_LONGITUDE_MESSAGE"
					hint="COM_SERVICEDIRECTORY_SUBREGION_LONGITUDE_HINT"
				/>
				<!-- Timezones Field. Type: Subform. (joomla) -->
				<field
					type="subform"
					name="timezones"
					label="COM_SERVICEDIRECTORY_SUBREGION_TIMEZONES_LABEL"
					layout="joomla.form.field.subform.repeatable"
					multiple="true"
					buttons="add,remove"
					description="COM_SERVICEDIRECTORY_SUBREGION_TIMEZONES_DESCRIPTION"
					icon="list"
					max="50"
					min="0"
					nested_depth="1">
					<form hidden="true" name="list_timezones_modal" repeat="true">
						<!-- Guid Field. Type: Hidden. (joomla) -->
						<field
							type="hidden"
							name="guid"
							default="0"
							filter="STRING"
						/>
						<!-- Timezone_name Field. Type: Text. (joomla) -->
						<field
							type="text"
							name="timezone_name"
							label="COM_SERVICEDIRECTORY_SUBREGION_TIMEZONE_NAME_LABEL"
							description="COM_SERVICEDIRECTORY_SUBREGION_TIMEZONE_NAME_DESCRIPTION"
							class="text_area"
							message="COM_SERVICEDIRECTORY_SUBREGION_TIMEZONE_NAME_MESSAGE"
							hint="COM_SERVICEDIRECTORY_SUBREGION_TIMEZONE_NAME_HINT"
						/>
						<!-- Timezone_identifier Field. Type: Text. (joomla) -->
						<field
							type="text"
							name="timezone_identifier"
							label="COM_SERVICEDIRECTORY_SUBREGION_TIMEZONE_IDENTIFIER_LABEL"
							description="COM_SERVICEDIRECTORY_SUBREGION_TIMEZONE_IDENTIFIER_DESCRIPTION"
							class="text_area"
							message="COM_SERVICEDIRECTORY_SUBREGION_TIMEZONE_IDENTIFIER_MESSAGE"
							hint="COM_SERVICEDIRECTORY_SUBREGION_TIMEZONE_IDENTIFIER_HINT"
						/>
						<!-- Gmt_offset_name Field. Type: Text. (joomla) -->
						<field
							type="text"
							name="gmt_offset_name"
							label="COM_SERVICEDIRECTORY_SUBREGION_GMT_OFFSET_NAME_LABEL"
							description="COM_SERVICEDIRECTORY_SUBREGION_GMT_OFFSET_NAME_DESCRIPTION"
							class="text_area"
							message="COM_SERVICEDIRECTORY_SUBREGION_GMT_OFFSET_NAME_MESSAGE"
							hint="COM_SERVICEDIRECTORY_SUBREGION_GMT_OFFSET_NAME_HINT"
						/>
						<!-- Gmt_offset_sec Field. Type: Text. (joomla) -->
						<field
							type="text"
							name="gmt_offset_sec"
							label="COM_SERVICEDIRECTORY_SUBREGION_GMT_OFFSET_SEC_LABEL"
							description="COM_SERVICEDIRECTORY_SUBREGION_GMT_OFFSET_SEC_DESCRIPTION"
							class="text_area"
							message="COM_SERVICEDIRECTORY_SUBREGION_GMT_OFFSET_SEC_MESSAGE"
							hint="COM_SERVICEDIRECTORY_SUBREGION_GMT_OFFSET_SEC_HINT"
						/>
						<!-- Abbreviation Field. Type: Text. (joomla) -->
						<field
							type="text"
							name="abbreviation"
							label="COM_SERVICEDIRECTORY_SUBREGION_ABBREVIATION_LABEL"
							description="COM_SERVICEDIRECTORY_SUBREGION_ABBREVIATION_DESCRIPTION"
							class="text_area"
							message="COM_SERVICEDIRECTORY_SUBREGION_ABBREVIATION_MESSAGE"
							hint="COM_SERVICEDIRECTORY_SUBREGION_ABBREVIATION_HINT"
						/>
					</form>
				</field>
			</form>
		</field>
		<!-- Wikidataid Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="wikidataid"
			label="COM_SERVICEDIRECTORY_SUBREGION_WIKIDATAID_LABEL"
			description="COM_SERVICEDIRECTORY_SUBREGION_WIKIDATAID_DESCRIPTION"
			hint="COM_SERVICEDIRECTORY_SUBREGION_WIKIDATAID_HINT"
		/>
	</fieldset>

	<!-- Access Control Fields. -->
	<fieldset name="accesscontrol">
		<!-- Asset Id Field. Type: Hidden (joomla) -->
		<field
			name="asset_id"
			type="hidden"
			filter="unset"
		/>
		<!-- Rules Field. Type: Rules (joomla) -->
		<field
			name="rules"
			type="rules"
			label="Permissions in relation to this subregion"
			translate_label="false"
			filter="rules"
			validate="rules"
			class="inputbox"
			component="com_servicedirectory"
			section="subregion"
		/>
	</fieldset>
</form>