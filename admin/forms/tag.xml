<?xml version="1.0" encoding="utf-8"?>
<form
	addruleprefix="JoomService\Component\Servicedirectory\Administrator\Rule"
	addfieldprefix="JoomService\Component\Servicedirectory\Administrator\Field"
>
	<config>
		<inlinehelp button="show"/>
	</config>
	<fieldset name="details">
		<!-- Default Fields. -->
		<!-- Id Field. Type: Text (joomla) -->
		<field
			name="id"
			type="text" class="readonly" label="JGLOBAL_FIELD_ID_LABEL"
			description ="JGLOBAL_FIELD_ID_DESC" size="10" default="0"
			readonly="true"
		/>
		<!-- Date Created Field. Type: Calendar (joomla) -->
		<field
			name="created"
			type="calendar"
			label="COM_SERVICEDIRECTORY_TAG_CREATED_DATE_LABEL"
			description="COM_SERVICEDIRECTORY_TAG_CREATED_DATE_DESC"
			size="22"
			format="%Y-%m-%d %H:%M:%S"
			filter="user_utc"
		/>
		<!-- User Created Field. Type: User (joomla) -->
		<field
			name="created_by"
			type="user"
			label="COM_SERVICEDIRECTORY_TAG_CREATED_BY_LABEL"
			description="COM_SERVICEDIRECTORY_TAG_CREATED_BY_DESC"
		/>
		<!-- Date Modified Field. Type: Calendar (joomla) -->
		<field name="modified" type="calendar" class="readonly"
			label="COM_SERVICEDIRECTORY_TAG_MODIFIED_DATE_LABEL" description="COM_SERVICEDIRECTORY_TAG_MODIFIED_DATE_DESC"
			size="22" readonly="true" format="%Y-%m-%d %H:%M:%S" filter="user_utc" />
		<!-- User Modified Field. Type: User (joomla) -->
		<field name="modified_by" type="user"
			label="COM_SERVICEDIRECTORY_TAG_MODIFIED_BY_LABEL"
			description="COM_SERVICEDIRECTORY_TAG_MODIFIED_BY_DESC"
			class="readonly"
			readonly="true"
			filter="unset"
		/>
		<!-- Access Field. Type: Accesslevel (joomla) -->
		<field name="access"
			type="accesslevel"
			label="JFIELD_ACCESS_LABEL"
			description="JFIELD_ACCESS_DESC"
			default="1"
			required="false"
		/>
		<!-- Ordering Field. Type: Numbers (joomla) -->
		<field
			name="ordering"
			type="number"
			class="inputbox validate-ordering"
			label="COM_SERVICEDIRECTORY_TAG_ORDERING_LABEL"
			description=""
			default="0"
			size="6"
			required="false"
		/>
		<!-- Version Field. Type: Text (joomla) -->
		<field
			name="version"
			type="text"
			class="readonly"
			label="COM_SERVICEDIRECTORY_TAG_VERSION_LABEL"
			description="COM_SERVICEDIRECTORY_TAG_VERSION_DESC"
			size="6"
			default="1"
			readonly="true"
			filter="unset"
		/>
		<!-- Was added due to Permissions JS needing a Title field -->
		<!-- Let us know at gh-629 should this change -->
		<!-- https://github.com/vdm-io/Joomla-Component-Builder/issues/629#issuecomment-750117235 -->
		<field
			name="title"
			type="hidden"
			default="servicedirectory tag"
		/>
		<!-- Dynamic Fields. -->
		<!-- Name Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="name"
			label="COM_SERVICEDIRECTORY_TAG_NAME_LABEL"
			size="40"
			maxlength="150"
			description="COM_SERVICEDIRECTORY_TAG_NAME_DESCRIPTION"
			class="text_area"
			readonly="false"
			disabled="false"
			required="true"
			filter="STRING"
			message="COM_SERVICEDIRECTORY_TAG_NAME_MESSAGE"
			hint="COM_SERVICEDIRECTORY_TAG_NAME_HINT"
		/>
		<!-- Description Field. Type: Textarea. (joomla) -->
		<field
			type="textarea"
			name="description"
			label="COM_SERVICEDIRECTORY_TAG_DESCRIPTION_LABEL"
			rows="11"
			cols="10"
			description="COM_SERVICEDIRECTORY_TAG_DESCRIPTION_DESCRIPTION"
			class="text_area span12"
			filter="HTML"
			hint="COM_SERVICEDIRECTORY_TAG_DESCRIPTION_HINT"
		/>
		<!-- Parent_guid Field. Type: Tags. (custom) -->
		<field
			type="tags"
			name="parent_guid"
			label="COM_SERVICEDIRECTORY_TAG_PARENT_GUID_LABEL"
			description="COM_SERVICEDIRECTORY_TAG_PARENT_GUID_DESCRIPTION"
			class="list_class"
			layout="joomla.form.field.list-fancy-select"
			multiple="true"
			required="false"
			button="false"
			entity="tag"
		/>
		<!-- Published Field. Type: List. (joomla) -->
		<field
			type="list"
			name="published"
			label="COM_SERVICEDIRECTORY_TAG_PUBLISHED_LABEL"
			description="COM_SERVICEDIRECTORY_TAG_PUBLISHED_DESCRIPTION"
			class="list_class"
			multiple="false"
			filter="INT"
			required="true"
			default="1">
			<!-- Option Set. -->
			<option value="1">
				COM_SERVICEDIRECTORY_TAG_PUBLISHED</option>
			<option value="0">
				COM_SERVICEDIRECTORY_TAG_UNPUBLISHED</option>
			<option value="2">
				COM_SERVICEDIRECTORY_TAG_ARCHIVED</option>
			<option value="-2">
				COM_SERVICEDIRECTORY_TAG_TRASHED</option>
		</field>
		<!-- Guid Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="guid"
			label="COM_SERVICEDIRECTORY_TAG_GUID_LABEL"
			size="40"
			maxlength="40"
			description="COM_SERVICEDIRECTORY_TAG_GUID_DESCRIPTION"
			class="text_area"
			readonly="true"
			filter="CMD"
			validate="guid"
			hint="COM_SERVICEDIRECTORY_TAG_GUID_HINT"
		/>
		<!-- Note_file_vdm_display Field. Type: Note. A None Database Field. (joomla) -->
		<field type="note" name="note_file_vdm_display" description="COM_SERVICEDIRECTORY_TAG_NOTE_FILE_VDM_DISPLAY_DESCRIPTION" class="uk-clearfix uk-width-1-1 uk-margin note_file_vdm_display" />
		<!-- Note_file_vdm_uploader Field. Type: Note. A None Database Field. (joomla) -->
		<field type="note" name="note_file_vdm_uploader" description="COM_SERVICEDIRECTORY_TAG_NOTE_FILE_VDM_UPLOADER_DESCRIPTION" class="note_file_vdm_uploader" showon="file_type!:" />
		<!-- File_type Field. Type: Entityfiletypes. (custom) -->
		<field
			type="entityfiletypes"
			name="file_type"
			label="COM_SERVICEDIRECTORY_TAG_FILE_TYPE_LABEL"
			class="list_class"
			layout="joomla.form.field.list-fancy-select"
			multiple="false"
			required="false"
			button="false"
			entity="tag"
		/>
		<!-- Lft Field. Type: Hidden. (joomla) -->
		<field
			type="hidden"
			name="lft"
			default="0"
		/>
		<!-- Rgt Field. Type: Hidden. (joomla) -->
		<field
			type="hidden"
			name="rgt"
			default="0"
		/>
		<!-- Level Field. Type: Integer. (joomla) -->
		<field
			type="integer"
			name="level"
			label="COM_SERVICEDIRECTORY_TAG_LEVEL_LABEL"
			description="COM_SERVICEDIRECTORY_TAG_LEVEL_DESCRIPTION"
			class="fieldSmall"
			first="0"
			last="20"
			step="1"
		/>
		<!-- Alias Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="alias"
			label="COM_SERVICEDIRECTORY_TAG_ALIAS_LABEL"
			description="JFIELD_ALIAS_DESC"
			readonly="true"
			filter="STRING"
			hint="COM_SERVICEDIRECTORY_TAG_ALIAS_HINT"
		/>
	</fieldset>

	<!-- Access Control Fields. -->
	<fieldset name="accesscontrol">
		<!-- Asset Id Field. Type: Hidden (joomla) -->
		<field
			name="asset_id"
			type="hidden"
			filter="unset"
		/>
		<!-- Rules Field. Type: Rules (joomla) -->
		<field
			name="rules"
			type="rules"
			label="Permissions in relation to this tag"
			translate_label="false"
			filter="rules"
			validate="rules"
			class="inputbox"
			component="com_servicedirectory"
			section="tag"
		/>
	</fieldset>
</form>