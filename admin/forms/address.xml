<?xml version="1.0" encoding="utf-8"?>
<form
	addruleprefix="JoomService\Component\Servicedirectory\Administrator\Rule"
	addfieldprefix="JoomService\Component\Servicedirectory\Administrator\Field"
>
	<config>
		<inlinehelp button="show"/>
	</config>
	<fieldset name="details">
		<!-- Default Fields. -->
		<!-- Id Field. Type: Text (joomla) -->
		<field
			name="id"
			type="text" class="readonly" label="JGLOBAL_FIELD_ID_LABEL"
			description ="JGLOBAL_FIELD_ID_DESC" size="10" default="0"
			readonly="true"
		/>
		<!-- Date Created Field. Type: Calendar (joomla) -->
		<field
			name="created"
			type="calendar"
			label="COM_SERVICEDIRECTORY_ADDRESS_CREATED_DATE_LABEL"
			description="COM_SERVICEDIRECTORY_ADDRESS_CREATED_DATE_DESC"
			size="22"
			format="%Y-%m-%d %H:%M:%S"
			filter="user_utc"
		/>
		<!-- User Created Field. Type: User (joomla) -->
		<field
			name="created_by"
			type="user"
			label="COM_SERVICEDIRECTORY_ADDRESS_CREATED_BY_LABEL"
			description="COM_SERVICEDIRECTORY_ADDRESS_CREATED_BY_DESC"
		/>
		<!-- Published Field. Type: List (joomla) -->
		<field name="published" type="list" label="JSTATUS"
			description="JFIELD_PUBLISHED_DESC" class="chzn-color-state"
			filter="intval" size="1" default="1" >
			<option value="1">
				JPUBLISHED</option>
			<option value="0">
				JUNPUBLISHED</option>
			<option value="2">
				JARCHIVED</option>
			<option value="-2">
				JTRASHED</option>
		</field>
		<!-- Date Modified Field. Type: Calendar (joomla) -->
		<field name="modified" type="calendar" class="readonly"
			label="COM_SERVICEDIRECTORY_ADDRESS_MODIFIED_DATE_LABEL" description="COM_SERVICEDIRECTORY_ADDRESS_MODIFIED_DATE_DESC"
			size="22" readonly="true" format="%Y-%m-%d %H:%M:%S" filter="user_utc" />
		<!-- User Modified Field. Type: User (joomla) -->
		<field name="modified_by" type="user"
			label="COM_SERVICEDIRECTORY_ADDRESS_MODIFIED_BY_LABEL"
			description="COM_SERVICEDIRECTORY_ADDRESS_MODIFIED_BY_DESC"
			class="readonly"
			readonly="true"
			filter="unset"
		/>
		<!-- Access Field. Type: Accesslevel (joomla) -->
		<field name="access"
			type="accesslevel"
			label="JFIELD_ACCESS_LABEL"
			description="JFIELD_ACCESS_DESC"
			default="1"
			required="false"
		/>
		<!-- Ordering Field. Type: Numbers (joomla) -->
		<field
			name="ordering"
			type="number"
			class="inputbox validate-ordering"
			label="COM_SERVICEDIRECTORY_ADDRESS_ORDERING_LABEL"
			description=""
			default="0"
			size="6"
			required="false"
		/>
		<!-- Version Field. Type: Text (joomla) -->
		<field
			name="version"
			type="text"
			class="readonly"
			label="COM_SERVICEDIRECTORY_ADDRESS_VERSION_LABEL"
			description="COM_SERVICEDIRECTORY_ADDRESS_VERSION_DESC"
			size="6"
			default="1"
			readonly="true"
			filter="unset"
		/>
		<!-- Was added due to Permissions JS needing a Title field -->
		<!-- Let us know at gh-629 should this change -->
		<!-- https://github.com/vdm-io/Joomla-Component-Builder/issues/629#issuecomment-750117235 -->
		<field
			name="title"
			type="hidden"
			default="servicedirectory address"
		/>
		<!-- Dynamic Fields. -->
		<!-- Line_one Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="line_one"
			label="COM_SERVICEDIRECTORY_ADDRESS_LINE_ONE_LABEL"
			description="COM_SERVICEDIRECTORY_ADDRESS_LINE_ONE_DESCRIPTION"
			class="text_area"
			required="true"
			filter="STRING"
			message="COM_SERVICEDIRECTORY_ADDRESS_LINE_ONE_MESSAGE"
			hint="COM_SERVICEDIRECTORY_ADDRESS_LINE_ONE_HINT"
		/>
		<!-- Type Field. Type: Modalselect. (custom) -->
		<field
			type="ModalSelect"
			name="type"
			label="COM_SERVICEDIRECTORY_ADDRESS_TYPE_LABEL"
			sql_title_table="#__servicedirectory_address_type"
			sql_title_column="name"
			data-key-name="guid"
			sql_title_key="guid"
			urlSelect="index.php?option=com_servicedirectory&amp;view=address_types&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			urlNew="index.php?option=com_servicedirectory&amp;task=address_type.add&amp;layout=modal&amp;tmpl=component"
			urlEdit="index.php?option=com_servicedirectory&amp;task=address_type.edit&amp;guid={id}&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			titleSelect="COM_SERVICEDIRECTORY_ADDRESS_TYPE_TITLESELECT"
			titleNew="COM_SERVICEDIRECTORY_ADDRESS_TYPE_TITLENEW"
			titleEdit="COM_SERVICEDIRECTORY_ADDRESS_TYPE_TITLEEDIT"
			iconSelect="icon-copy"
			select="true"
			new="true"
			edit="true"
			clear="true"
			required="true"
			class="input-large"
			description="COM_SERVICEDIRECTORY_ADDRESS_TYPE_DESCRIPTION"
			hint="COM_SERVICEDIRECTORY_ADDRESS_TYPE_HINT"
		/>
		<!-- Country Field. Type: Modalselect. (custom) -->
		<field
			type="ModalSelect"
			name="country"
			label="COM_SERVICEDIRECTORY_ADDRESS_COUNTRY_LABEL"
			sql_title_table="#__servicedirectory_country"
			sql_title_column="name"
			data-key-name="guid"
			sql_title_key="guid"
			urlSelect="index.php?option=com_servicedirectory&amp;view=countries&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			urlNew="index.php?option=com_servicedirectory&amp;task=country.add&amp;layout=modal&amp;tmpl=component"
			urlEdit="index.php?option=com_servicedirectory&amp;task=country.edit&amp;guid={id}&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			titleSelect="COM_SERVICEDIRECTORY_ADDRESS_COUNTRY_TITLESELECT"
			titleNew="COM_SERVICEDIRECTORY_ADDRESS_COUNTRY_TITLENEW"
			titleEdit="COM_SERVICEDIRECTORY_ADDRESS_COUNTRY_TITLEEDIT"
			iconSelect="icon-copy"
			select="true"
			new="true"
			edit="true"
			clear="true"
			required="true"
			filter="STRING"
			validate="guid"
			class="input-large"
			description="COM_SERVICEDIRECTORY_ADDRESS_COUNTRY_DESCRIPTION"
			hint="COM_SERVICEDIRECTORY_ADDRESS_COUNTRY_HINT"
		/>
		<!-- State Field. Type: Modalselect. (custom) -->
		<field
			type="ModalSelect"
			name="state"
			label="COM_SERVICEDIRECTORY_ADDRESS_STATE_LABEL"
			sql_title_table="#__servicedirectory_state"
			sql_title_column="name"
			data-key-name="guid"
			sql_title_key="guid"
			urlSelect="index.php?option=com_servicedirectory&amp;view=states&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			urlNew="index.php?option=com_servicedirectory&amp;task=state.add&amp;layout=modal&amp;tmpl=component"
			urlEdit="index.php?option=com_servicedirectory&amp;task=state.edit&amp;guid={id}&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			titleSelect="COM_SERVICEDIRECTORY_ADDRESS_STATE_TITLESELECT"
			titleNew="COM_SERVICEDIRECTORY_ADDRESS_STATE_TITLENEW"
			titleEdit="COM_SERVICEDIRECTORY_ADDRESS_STATE_TITLEEDIT"
			iconSelect="icon-copy"
			select="true"
			new="true"
			edit="true"
			clear="true"
			required="true"
			class="input-large"
			description="COM_SERVICEDIRECTORY_ADDRESS_STATE_DESCRIPTION"
			hint="COM_SERVICEDIRECTORY_ADDRESS_STATE_HINT"
		/>
		<!-- City Field. Type: Modalselect. (custom) -->
		<field
			type="ModalSelect"
			name="city"
			label="COM_SERVICEDIRECTORY_ADDRESS_CITY_LABEL"
			sql_title_table="#__servicedirectory_city"
			sql_title_column="name"
			data-key-name="guid"
			sql_title_key="guid"
			urlSelect="index.php?option=com_servicedirectory&amp;view=cities&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			urlNew="index.php?option=com_servicedirectory&amp;task=city.add&amp;layout=modal&amp;tmpl=component"
			urlEdit="index.php?option=com_servicedirectory&amp;task=city.edit&amp;guid={id}&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			titleSelect="COM_SERVICEDIRECTORY_ADDRESS_CITY_TITLESELECT"
			titleNew="COM_SERVICEDIRECTORY_ADDRESS_CITY_TITLENEW"
			titleEdit="COM_SERVICEDIRECTORY_ADDRESS_CITY_TITLEEDIT"
			iconSelect="icon-copy"
			select="true"
			new="true"
			edit="true"
			clear="true"
			class="input-large"
			description="COM_SERVICEDIRECTORY_ADDRESS_CITY_DESCRIPTION"
			hint="COM_SERVICEDIRECTORY_ADDRESS_CITY_HINT"
		/>
		<!-- Company Field. Type: Modalselect. (custom) -->
		<field
			type="ModalSelect"
			name="company"
			label="COM_SERVICEDIRECTORY_ADDRESS_COMPANY_LABEL"
			sql_title_table="#__servicedirectory_company"
			sql_title_column="name"
			data-key-name="guid"
			sql_title_key="guid"
			urlSelect="index.php?option=com_servicedirectory&amp;view=companies&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			urlNew="index.php?option=com_servicedirectory&amp;task=company.add&amp;layout=modal&amp;tmpl=component"
			urlEdit="index.php?option=com_servicedirectory&amp;task=company.edit&amp;guid={id}&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			titleSelect="COM_SERVICEDIRECTORY_ADDRESS_COMPANY_TITLESELECT"
			titleNew="COM_SERVICEDIRECTORY_ADDRESS_COMPANY_TITLENEW"
			titleEdit="COM_SERVICEDIRECTORY_ADDRESS_COMPANY_TITLEEDIT"
			iconSelect="icon-copy"
			select="true"
			new="true"
			edit="true"
			clear="true"
			required="false"
			class="input-large"
			hint="COM_SERVICEDIRECTORY_ADDRESS_COMPANY_HINT"
		/>
		<!-- Guid Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="guid"
			label="COM_SERVICEDIRECTORY_ADDRESS_GUID_LABEL"
			size="40"
			maxlength="40"
			description="COM_SERVICEDIRECTORY_ADDRESS_GUID_DESCRIPTION"
			class="text_area"
			readonly="true"
			filter="CMD"
			validate="guid"
			hint="COM_SERVICEDIRECTORY_ADDRESS_GUID_HINT"
		/>
		<!-- Postal Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="postal"
			label="COM_SERVICEDIRECTORY_ADDRESS_POSTAL_LABEL"
			description="COM_SERVICEDIRECTORY_ADDRESS_POSTAL_DESCRIPTION"
			class="text_area"
			required="false"
			hint="COM_SERVICEDIRECTORY_ADDRESS_POSTAL_HINT"
		/>
		<!-- Line_two Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="line_two"
			label="COM_SERVICEDIRECTORY_ADDRESS_LINE_TWO_LABEL"
			description="COM_SERVICEDIRECTORY_ADDRESS_LINE_TWO_DESCRIPTION"
			class="text_area"
			required="false"
			filter="STRING"
			hint="COM_SERVICEDIRECTORY_ADDRESS_LINE_TWO_HINT"
		/>
	</fieldset>

	<!-- Access Control Fields. -->
	<fieldset name="accesscontrol">
		<!-- Asset Id Field. Type: Hidden (joomla) -->
		<field
			name="asset_id"
			type="hidden"
			filter="unset"
		/>
		<!-- Rules Field. Type: Rules (joomla) -->
		<field
			name="rules"
			type="rules"
			label="Permissions in relation to this address"
			translate_label="false"
			filter="rules"
			validate="rules"
			class="inputbox"
			component="com_servicedirectory"
			section="address"
		/>
	</fieldset>
</form>