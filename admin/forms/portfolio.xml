<?xml version="1.0" encoding="utf-8"?>
<form
	addruleprefix="JoomService\Component\Servicedirectory\Administrator\Rule"
	addfieldprefix="JoomService\Component\Servicedirectory\Administrator\Field"
>
	<config>
		<inlinehelp button="show"/>
	</config>
	<fieldset name="details">
		<!-- Default Fields. -->
		<!-- Id Field. Type: Text (joomla) -->
		<field
			name="id"
			type="text" class="readonly" label="JGLOBAL_FIELD_ID_LABEL"
			description ="JGLOBAL_FIELD_ID_DESC" size="10" default="0"
			readonly="true"
		/>
		<!-- Date Created Field. Type: Calendar (joomla) -->
		<field
			name="created"
			type="calendar"
			label="COM_SERVICEDIRECTORY_PORTFOLIO_CREATED_DATE_LABEL"
			description="COM_SERVICEDIRECTORY_PORTFOLIO_CREATED_DATE_DESC"
			size="22"
			format="%Y-%m-%d %H:%M:%S"
			filter="user_utc"
		/>
		<!-- User Created Field. Type: User (joomla) -->
		<field
			name="created_by"
			type="user"
			label="COM_SERVICEDIRECTORY_PORTFOLIO_CREATED_BY_LABEL"
			description="COM_SERVICEDIRECTORY_PORTFOLIO_CREATED_BY_DESC"
		/>
		<!-- Published Field. Type: List (joomla) -->
		<field name="published" type="list" label="JSTATUS"
			description="JFIELD_PUBLISHED_DESC" class="chzn-color-state"
			filter="intval" size="1" default="1" >
			<option value="1">
				JPUBLISHED</option>
			<option value="0">
				JUNPUBLISHED</option>
			<option value="2">
				JARCHIVED</option>
			<option value="-2">
				JTRASHED</option>
		</field>
		<!-- Date Modified Field. Type: Calendar (joomla) -->
		<field name="modified" type="calendar" class="readonly"
			label="COM_SERVICEDIRECTORY_PORTFOLIO_MODIFIED_DATE_LABEL" description="COM_SERVICEDIRECTORY_PORTFOLIO_MODIFIED_DATE_DESC"
			size="22" readonly="true" format="%Y-%m-%d %H:%M:%S" filter="user_utc" />
		<!-- User Modified Field. Type: User (joomla) -->
		<field name="modified_by" type="user"
			label="COM_SERVICEDIRECTORY_PORTFOLIO_MODIFIED_BY_LABEL"
			description="COM_SERVICEDIRECTORY_PORTFOLIO_MODIFIED_BY_DESC"
			class="readonly"
			readonly="true"
			filter="unset"
		/>
		<!-- Access Field. Type: Accesslevel (joomla) -->
		<field name="access"
			type="accesslevel"
			label="JFIELD_ACCESS_LABEL"
			description="JFIELD_ACCESS_DESC"
			default="1"
			required="false"
		/>
		<!-- Ordering Field. Type: Numbers (joomla) -->
		<field
			name="ordering"
			type="number"
			class="inputbox validate-ordering"
			label="COM_SERVICEDIRECTORY_PORTFOLIO_ORDERING_LABEL"
			description=""
			default="0"
			size="6"
			required="false"
		/>
		<!-- Version Field. Type: Text (joomla) -->
		<field
			name="version"
			type="text"
			class="readonly"
			label="COM_SERVICEDIRECTORY_PORTFOLIO_VERSION_LABEL"
			description="COM_SERVICEDIRECTORY_PORTFOLIO_VERSION_DESC"
			size="6"
			default="1"
			readonly="true"
			filter="unset"
		/>
		<!-- Was added due to Permissions JS needing a Title field -->
		<!-- Let us know at gh-629 should this change -->
		<!-- https://github.com/vdm-io/Joomla-Component-Builder/issues/629#issuecomment-750117235 -->
		<field
			name="title"
			type="hidden"
			default="servicedirectory portfolio"
		/>
		<!-- Dynamic Fields. -->
		<!-- Project_title Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="project_title"
			label="COM_SERVICEDIRECTORY_PORTFOLIO_PROJECT_TITLE_LABEL"
			description="COM_SERVICEDIRECTORY_PORTFOLIO_PROJECT_TITLE_DESCRIPTION"
			class="text_area"
			required="true"
			filter="STRING"
			message="COM_SERVICEDIRECTORY_PORTFOLIO_PROJECT_TITLE_MESSAGE"
			hint="COM_SERVICEDIRECTORY_PORTFOLIO_PROJECT_TITLE_HINT"
		/>
		<!-- Company Field. Type: Modalselect. (custom) -->
		<field
			type="ModalSelect"
			name="company"
			label="COM_SERVICEDIRECTORY_PORTFOLIO_COMPANY_LABEL"
			sql_title_table="#__servicedirectory_company"
			sql_title_column="name"
			data-key-name="guid"
			sql_title_key="guid"
			urlSelect="index.php?option=com_servicedirectory&amp;view=companies&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			urlNew="index.php?option=com_servicedirectory&amp;task=company.add&amp;layout=modal&amp;tmpl=component"
			urlEdit="index.php?option=com_servicedirectory&amp;task=company.edit&amp;guid={id}&amp;layout=modal&amp;tmpl=component&amp;titleKey=guid"
			titleSelect="COM_SERVICEDIRECTORY_PORTFOLIO_COMPANY_TITLESELECT"
			titleNew="COM_SERVICEDIRECTORY_PORTFOLIO_COMPANY_TITLENEW"
			titleEdit="COM_SERVICEDIRECTORY_PORTFOLIO_COMPANY_TITLEEDIT"
			iconSelect="icon-copy"
			select="true"
			new="true"
			edit="true"
			clear="true"
			required="false"
			class="input-large"
			hint="COM_SERVICEDIRECTORY_PORTFOLIO_COMPANY_HINT"
		/>
		<!-- Client_name Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="client_name"
			label="COM_SERVICEDIRECTORY_PORTFOLIO_CLIENT_NAME_LABEL"
			description="COM_SERVICEDIRECTORY_PORTFOLIO_CLIENT_NAME_DESCRIPTION"
			class="text_area"
			hint="COM_SERVICEDIRECTORY_PORTFOLIO_CLIENT_NAME_HINT"
		/>
		<!-- Target_industry Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="target_industry"
			label="COM_SERVICEDIRECTORY_PORTFOLIO_TARGET_INDUSTRY_LABEL"
			description="COM_SERVICEDIRECTORY_PORTFOLIO_TARGET_INDUSTRY_DESCRIPTION"
			class="text_area"
			required="true"
			hint="COM_SERVICEDIRECTORY_PORTFOLIO_TARGET_INDUSTRY_HINT"
		/>
		<!-- Guid Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="guid"
			label="COM_SERVICEDIRECTORY_PORTFOLIO_GUID_LABEL"
			size="40"
			maxlength="40"
			description="COM_SERVICEDIRECTORY_PORTFOLIO_GUID_DESCRIPTION"
			class="text_area"
			readonly="true"
			filter="CMD"
			validate="guid"
			hint="COM_SERVICEDIRECTORY_PORTFOLIO_GUID_HINT"
		/>
		<!-- Description Field. Type: Editor. (joomla) -->
		<field
			type="editor"
			name="description"
			label="COM_SERVICEDIRECTORY_PORTFOLIO_DESCRIPTION_LABEL"
			description="COM_SERVICEDIRECTORY_PORTFOLIO_DESCRIPTION_DESCRIPTION"
			message="COM_SERVICEDIRECTORY_PORTFOLIO_DESCRIPTION_MESSAGE"
			width="100%"
			height="400"
			maxlength="2000"
			buttons="false"
			syntax="markdown"
			editor="codemirror|none"
			filter="STRING"
			required="true"
			validate="maxlength"
		/>
		<!-- Project_url Field. Type: Url. (joomla) -->
		<field
			type="url"
			name="project_url"
			label="COM_SERVICEDIRECTORY_PORTFOLIO_PROJECT_URL_LABEL"
			description="COM_SERVICEDIRECTORY_PORTFOLIO_PROJECT_URL_DESCRIPTION"
			class="text_area"
			required="false"
			filter="url"
			validated="url"
			scheme="http,https"
			message="COM_SERVICEDIRECTORY_PORTFOLIO_PROJECT_URL_MESSAGE"
			hint="COM_SERVICEDIRECTORY_PORTFOLIO_PROJECT_URL_HINT"
		/>
		<!-- Services_provided Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="services_provided"
			label="COM_SERVICEDIRECTORY_PORTFOLIO_SERVICES_PROVIDED_LABEL"
			description="COM_SERVICEDIRECTORY_PORTFOLIO_SERVICES_PROVIDED_DESCRIPTION"
			class="text_area"
			required="true"
			hint="COM_SERVICEDIRECTORY_PORTFOLIO_SERVICES_PROVIDED_HINT"
		/>
	</fieldset>

	<!-- Access Control Fields. -->
	<fieldset name="accesscontrol">
		<!-- Asset Id Field. Type: Hidden (joomla) -->
		<field
			name="asset_id"
			type="hidden"
			filter="unset"
		/>
		<!-- Rules Field. Type: Rules (joomla) -->
		<field
			name="rules"
			type="rules"
			label="Permissions in relation to this portfolio"
			translate_label="false"
			filter="rules"
			validate="rules"
			class="inputbox"
			component="com_servicedirectory"
			section="portfolio"
		/>
	</fieldset>
</form>