<?xml version="1.0" encoding="utf-8"?>
<form
	addruleprefix="JoomService\Component\Servicedirectory\Administrator\Rule"
	addfieldprefix="JoomService\Component\Servicedirectory\Administrator\Field"
>
	<fields name="filter">
		<field
			type="text"
			name="search"
			inputmode="search"
			label="COM_SERVICEDIRECTORY_FILTER_SEARCH"
			description="COM_SERVICEDIRECTORY_FILTER_SEARCH_TICKETS"
			hint="JSEARCH_FILTER"
		/>
		<field
			type="accesslevel"
			name="access"
			label="JGRID_HEADING_ACCESS"
			hint="JOPTION_SELECT_ACCESS"
			multiple="true"
			class="js-select-submit-on-change"
			layout="joomla.form.field.list-fancy-select"
		/>
		<field
			type="companies"
			name="company"
			label="COM_SERVICEDIRECTORY_TICKET_COMPANY_LABEL"
			multiple="false"
			class="js-select-submit-on-change"
		/>
		<field
			type="ticketsfilterpublished"
			name="published"
			label="COM_SERVICEDIRECTORY_TICKET_PUBLISHED_LABEL"
			multiple="false"
			class="js-select-submit-on-change"
		/>
		<input type="hidden" name="form_submited" value="1"/>
	</fields>

	<fields name="list">
		<field
			name="fullordering"
			type="list"
			label="JGLOBAL_SORT_BY"
			class="js-select-submit-on-change"
			default="a.id DESC"
			validate="options"
		>
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.ordering ASC">JGRID_HEADING_ORDERING_ASC</option>
			<option value="a.ordering DESC">JGRID_HEADING_ORDERING_DESC</option>
			<option value="a.subject ASC">COM_SERVICEDIRECTORY_FILTER_SUBJECT_ASCENDING</option>
			<option value="a.subject DESC">COM_SERVICEDIRECTORY_FILTER_SUBJECT_DESCENDING</option>
			<option value="g.name ASC">COM_SERVICEDIRECTORY_FILTER_COMPANY_ASCENDING</option>
			<option value="g.name DESC">COM_SERVICEDIRECTORY_FILTER_COMPANY_DESCENDING</option>
			<option value="a.published ASC">COM_SERVICEDIRECTORY_FILTER_STATUS_ASCENDING</option>
			<option value="a.published DESC">COM_SERVICEDIRECTORY_FILTER_STATUS_DESCENDING</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>

		<field
			name="limit"
			type="limitbox"
			label="JGLOBAL_LIST_LIMIT"
			default="25"
			class="js-select-submit-on-change"
		/>
	</fields>
</form>