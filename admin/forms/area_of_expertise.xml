<?xml version="1.0" encoding="utf-8"?>
<form
	addruleprefix="JoomService\Component\Servicedirectory\Administrator\Rule"
	addfieldprefix="JoomService\Component\Servicedirectory\Administrator\Field"
>
	<config>
		<inlinehelp button="show"/>
	</config>
	<fieldset name="details">
		<!-- Default Fields. -->
		<!-- Id Field. Type: Text (joomla) -->
		<field
			name="id"
			type="text" class="readonly" label="JGLOBAL_FIELD_ID_LABEL"
			description ="JGLOBAL_FIELD_ID_DESC" size="10" default="0"
			readonly="true"
		/>
		<!-- Date Created Field. Type: Calendar (joomla) -->
		<field
			name="created"
			type="calendar"
			label="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_CREATED_DATE_LABEL"
			description="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_CREATED_DATE_DESC"
			size="22"
			format="%Y-%m-%d %H:%M:%S"
			filter="user_utc"
		/>
		<!-- User Created Field. Type: User (joomla) -->
		<field
			name="created_by"
			type="user"
			label="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_CREATED_BY_LABEL"
			description="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_CREATED_BY_DESC"
		/>
		<!-- Published Field. Type: List (joomla) -->
		<field name="published" type="list" label="JSTATUS"
			description="JFIELD_PUBLISHED_DESC" class="chzn-color-state"
			filter="intval" size="1" default="1" >
			<option value="1">
				JPUBLISHED</option>
			<option value="0">
				JUNPUBLISHED</option>
			<option value="2">
				JARCHIVED</option>
			<option value="-2">
				JTRASHED</option>
		</field>
		<!-- Date Modified Field. Type: Calendar (joomla) -->
		<field name="modified" type="calendar" class="readonly"
			label="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_MODIFIED_DATE_LABEL" description="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_MODIFIED_DATE_DESC"
			size="22" readonly="true" format="%Y-%m-%d %H:%M:%S" filter="user_utc" />
		<!-- User Modified Field. Type: User (joomla) -->
		<field name="modified_by" type="user"
			label="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_MODIFIED_BY_LABEL"
			description="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_MODIFIED_BY_DESC"
			class="readonly"
			readonly="true"
			filter="unset"
		/>
		<!-- Access Field. Type: Accesslevel (joomla) -->
		<field name="access"
			type="accesslevel"
			label="JFIELD_ACCESS_LABEL"
			description="JFIELD_ACCESS_DESC"
			default="1"
			required="false"
		/>
		<!-- Ordering Field. Type: Numbers (joomla) -->
		<field
			name="ordering"
			type="number"
			class="inputbox validate-ordering"
			label="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_ORDERING_LABEL"
			description=""
			default="0"
			size="6"
			required="false"
		/>
		<!-- Version Field. Type: Text (joomla) -->
		<field
			name="version"
			type="text"
			class="readonly"
			label="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_VERSION_LABEL"
			description="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_VERSION_DESC"
			size="6"
			default="1"
			readonly="true"
			filter="unset"
		/>
		<!-- Was added due to Permissions JS needing a Title field -->
		<!-- Let us know at gh-629 should this change -->
		<!-- https://github.com/vdm-io/Joomla-Component-Builder/issues/629#issuecomment-750117235 -->
		<field
			name="title"
			type="hidden"
			default="servicedirectory area_of_expertise"
		/>
		<!-- Dynamic Fields. -->
		<!-- Name Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="name"
			label="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_NAME_LABEL"
			size="40"
			maxlength="150"
			description="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_NAME_DESCRIPTION"
			class="text_area"
			readonly="false"
			disabled="false"
			required="true"
			filter="STRING"
			message="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_NAME_MESSAGE"
			hint="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_NAME_HINT"
		/>
		<!-- Description Field. Type: Editor. (joomla) -->
		<field
			type="editor"
			name="description"
			label="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_DESCRIPTION_LABEL"
			description="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_DESCRIPTION_DESCRIPTION"
			message="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_DESCRIPTION_MESSAGE"
			width="100%"
			height="400"
			maxlength="2000"
			buttons="false"
			syntax="markdown"
			editor="codemirror|none"
			filter="STRING"
			required="true"
			validate="maxlength"
		/>
		<!-- Guid Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="guid"
			label="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_GUID_LABEL"
			size="40"
			maxlength="40"
			description="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_GUID_DESCRIPTION"
			class="text_area"
			readonly="true"
			filter="CMD"
			validate="guid"
			hint="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_GUID_HINT"
		/>
		<!-- Note_file_vdm_display Field. Type: Note. A None Database Field. (joomla) -->
		<field type="note" name="note_file_vdm_display" description="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_NOTE_FILE_VDM_DISPLAY_DESCRIPTION" class="uk-clearfix uk-width-1-1 uk-margin note_file_vdm_display" />
		<!-- Note_file_vdm_uploader Field. Type: Note. A None Database Field. (joomla) -->
		<field type="note" name="note_file_vdm_uploader" description="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_NOTE_FILE_VDM_UPLOADER_DESCRIPTION" class="note_file_vdm_uploader" showon="file_type!:" />
		<!-- File_type Field. Type: Entityfiletypes. (custom) -->
		<field
			type="entityfiletypes"
			name="file_type"
			label="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_FILE_TYPE_LABEL"
			class="list_class"
			layout="joomla.form.field.list-fancy-select"
			multiple="false"
			required="false"
			button="false"
			entity="area_of_expertise"
		/>
		<!-- Alias Field. Type: Text. (joomla) -->
		<field
			type="text"
			name="alias"
			label="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_ALIAS_LABEL"
			description="JFIELD_ALIAS_DESC"
			readonly="true"
			filter="STRING"
			hint="COM_SERVICEDIRECTORY_AREA_OF_EXPERTISE_ALIAS_HINT"
		/>
	</fieldset>

	<!-- Access Control Fields. -->
	<fieldset name="accesscontrol">
		<!-- Asset Id Field. Type: Hidden (joomla) -->
		<field
			name="asset_id"
			type="hidden"
			filter="unset"
		/>
		<!-- Rules Field. Type: Rules (joomla) -->
		<field
			name="rules"
			type="rules"
			label="Permissions in relation to this area_of_expertise"
			translate_label="false"
			filter="rules"
			validate="rules"
			class="inputbox"
			component="com_servicedirectory"
			section="area_of_expertise"
		/>
	</fieldset>
</form>