		<field
			type="radio"
			name="show_login"
			label="COM_SERVICEDIRECTORY_CONFIG_SHOW_LOGIN_LABEL"
			layout="joomla.form.field.radio.switcher"
			default=""
			filter="string">
			<!--  Global & Option Set. -->
			<option value="">
				JGLOBAL_USE_GLOBAL</option>
			<option value="1">
				COM_SERVICEDIRECTORY_CONFIG_YES</option>
			<option value="0">
				COM_SERVICEDIRECTORY_CONFIG_NO</option>
		</field>
		</fieldset>
	</fields>
